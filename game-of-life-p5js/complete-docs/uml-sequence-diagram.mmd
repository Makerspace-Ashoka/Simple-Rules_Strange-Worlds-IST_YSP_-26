    %% Participants with clear naming
    participant User as "User"
    participant Setup as "Setup Phase"
    participant GameLoop as "Game Loop"
    participant GridMgmt as "Grid Management"
    participant GameLogic as "Game Logic"
    participant Display as "Display"
    participant UI as "UI Controls"
    participant Patterns as "Patterns"

    %% Initial setup sequence
    Note over Setup: Browser loads index.html
    Setup->>Setup: setup() function begins
    Setup->>GridMgmt: initializeGrid()
    GridMgmt-->>Setup: Empty grid created
    Setup->>UI: createButtons()
    UI-->>Setup: UI controls created
    Setup->>Patterns: createPatternButtons()
    Patterns-->>Setup: Pattern buttons created
    Setup->>GridMgmt: randomizeGrid()
    GridMgmt-->>Setup: Grid filled with random cells
    Setup-->>GameLoop: setup() complete

    %% Main game loop
    loop Every frame (controlled by frameRate)
        GameLoop->>GameLoop: draw() function begins
        GameLoop->>Display: displayStatus()
        Display-->>GameLoop: Status displayed
        GameLoop->>Display: drawGrid()
        Display->>GridMgmt: Read current grid state
        GridMgmt-->>Display: Grid data
        Display-->>GameLoop: Grid displayed

        alt isRunning == true
            GameLoop->>GameLogic: computeNextGeneration()
            GameLogic->>GridMgmt: Read current grid
            GridMgmt-->>GameLogic: Current grid data

            loop For each cell in grid
                GameLogic->>GameLogic: countNeighbors()
                GameLogic->>GameLogic: applyRules()
                GameLogic->>GameLogic: Store result in nextGrid
            end

            GameLogic->>GridMgmt: Swap grid and nextGrid
            GridMgmt-->>GameLogic: Grids swapped
            GameLogic-->>GameLoop: Next generation computed
            GameLoop->>GameLoop: Increment generation counter
        end
    end

    %% User interactions
    Note over User,UI: User Interactions

    %% Play/Pause
    User->>UI: Click Play/Pause button
    UI->>GameLoop: toggleSimulation()
    GameLoop->>GameLoop: Toggle isRunning state
    GameLoop-->>UI: State updated
    UI-->>User: Visual feedback (button state)

    %% Step
    User->>UI: Click Step button
    UI->>GameLogic: stepSimulation()
    GameLogic->>GameLogic: computeNextGeneration()
    GameLogic->>GameLoop: Increment generation
    GameLoop-->>UI: State updated
    UI-->>User: Visual feedback (generation count)

    %% Clear
    User->>UI: Click Clear button
    UI->>GridMgmt: clearGrid()
    GridMgmt->>GridMgmt: Set all cells to 0
    GridMgmt->>GameLoop: Reset generation counter
    GameLoop-->>UI: State updated
    UI-->>User: Visual feedback (empty grid)

    %% Random
    User->>UI: Click Random button
    UI->>GridMgmt: randomizeGrid()
    GridMgmt->>GridMgmt: Fill with random values
    GridMgmt->>GameLoop: Reset generation counter
    GameLoop-->>UI: State updated
    UI-->>User: Visual feedback (random grid)

    %% Add pattern
    User->>Patterns: Click pattern button
    Patterns->>GridMgmt: placePattern()
    GridMgmt->>GridMgmt: Add pattern to grid
    GridMgmt-->>Patterns: Pattern added
    Patterns-->>User: Visual feedback (pattern appears)

    %% Toggle cell
    User->>Display: Click on a cell
    Display->>GameLoop: mousePressed() event
    GameLoop->>GridMgmt: toggleCell()
    GridMgmt->>GridMgmt: Flip cell state (0/1)
    GridMgmt-->>GameLoop: Cell updated
    GameLoop-->>Display: Redraw grid
    Display-->>User: Visual feedback (cell changes)

    %% Adjust speed
    User->>UI: Move speed slider
    UI->>GameLoop: Update frameRate
    GameLoop-->>UI: Speed updated
    UI-->>User: Visual feedback (simulation speed)

